# Environment Variables — copy this to .env.dev / .env.staging / .env.prod

# Application base URL for browser tests
BASE_URL=

# API base URL (defaults to BASE_URL if omitted)
API_BASE_URL=

# Test environment name (used by playwright.config.ts to load the right .env file)
TEST_ENV=dev

# ─── AI Failure Analysis & GitHub Issue Creation ───────────────────────────────
# GitHub Personal Access Token — needs "repo" scope.
# Also used as the credential for GitHub Models API (no extra key needed).
GITHUB_TOKEN=ghp_your_token_here

# Set to "true" to enable automatic issue creation when a test fails.
# Leave unset or "false" during local development to avoid noise.
AI_ISSUE_CREATION=false

# GitHub repository where issues will be created (owner/repo)
GITHUB_OWNER=
GITHUB_REPO=

# AI model to use via GitHub Models API (default: gpt-4o-mini)
# Other options: gpt-4o, meta-llama-3-70b-instruct, mistral-large
AI_MODEL=gpt-4o-mini

# Login (per-tier) credentials — used by features/ui/login.feature
LOGIN_BRONZE_EMAIL=
LOGIN_SILVER_EMAIL=
LOGIN_GOLD_EMAIL=
LOGIN_PLATINUM_EMAIL=
LOGIN_VALID_PASSWORD=
LOGIN_WRONG_PASSWORD=not-the-password
LOGIN_UNKNOWN_EMAIL=nobody@nowhere.test
